@using OrchardCore.Modules
@using OrchardCore.Users
@using OrchardCoreContrib.Avatars
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.DependencyInjection
@using System.Security.Claims

@inject IAuthorizationService AuthorizationService
@attribute [Feature("OrchardCoreContrib.Users.Avatar")]

@* Same as the stock OrchardCore.Users UserMenu.cshtml for anonymous visitors. *@
@if (!User.Identity.IsAuthenticated)
{
    @if (Model.AnonymousContent?.Items != null && Model.AnonymousContent.Items.Count > 0)
    {
        <li class="nav-item dropdown text-end">
            <a class="dropdown-toggle nav-link" id="navbarDropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" role="button">
                @if (Model.AnonymousHeader?.Items != null && Model.AnonymousHeader.Items.Count > 0)
                {
                    @await DisplayAsync(Model.AnonymousHeader)
                }
                else
                {
                    <span>@T["Users"]</span>
                }
            </a>

            <ul class="dropdown-menu dropdown-menu-end">
                @await DisplayAsync(Model.AnonymousContent)
            </ul>
        </li>

        return;
    }

    <li class="nav-item text-end">
        <a class="nav-link" asp-route-area="@UserConstants.Features.Users" asp-controller="Account" asp-action="Login">
            <i class="fa-solid fa-right-to-bracket fa-width-auto" aria-hidden="true"></i> @T["Log in"]
        </a>
    </li>

    return;
}

@{
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);

    // Orchard Core binds a module's shape templates to every enabled feature of the module, so this
    // view is active whenever any OrchardCoreContrib.Users feature is (e.g. only Impersonation), not
    // just Avatar. IAvatarService comes from the Avatar feature (or another avatar provider, or the
    // NullAvatarService fallback of AddOrchardCoreContrib()), so resolve it optionally.
    var avatarService = Context.RequestServices.GetService<IAvatarService>();
    var avatar = avatarService?.GetAvatar(new AvatarContext { DisplayName = User.Identity.Name });
}

<div class="dropdown">
    <form asp-route-area="OrchardCore.Users" asp-controller="Account" asp-action="LogOff" method="post" class="no-multisubmit">
        <a class="dropdown-toggle" id="navbarDropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" role="button">
            @if (!string.IsNullOrEmpty(avatar))
            {
                <img src="@avatar" />
            }
            else
            {
                <i class="fa-solid fa-circle-user" aria-hidden="true"></i>
            }
        </a>
        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
            <li><h6 class="dropdown-header">@T["Signed in as"]<span class="ms-1 font-weight-bold">@User.Identity.Name</span></h6></li>
            <li><hr class="dropdown-divider" /></li>
            @*
            TODO: Use CommonPermissions.EditOwnUser once 1.6.0 is released
            *@
            @if (await AuthorizationService.AuthorizeAsync(User, UsersPermissions.ManageUsers))
            {
                <li><a class="dropdown-item" asp-area="OrchardCore.Users" asp-action="Edit" asp-controller="Admin" asp-route-returnUrl="@FullRequestPath"><span><i class="far fa-address-card" aria-hidden="true"></i></span>&nbsp;<span> @T["Profile"]</span></a></li>
            }
            else if (await AuthorizationService.AuthorizeAsync(User, UsersPermissions.ViewUsers))
            {
                <li><a class="dropdown-item" asp-area="OrchardCore.Users" asp-action="Display" asp-controller="Admin" asp-route-id="@userId" asp-route-returnUrl="@FullRequestPath"><span><i class="far fa-address-card" aria-hidden="true"></i></span>&nbsp;<span> @T["Profile"]</span></a></li>
            }
            <li><a class="dropdown-item" asp-area="OrchardCore.Users" asp-controller="Account" asp-action="ChangePassword" asp-route-returnUrl="@FullRequestPath"><span><i class="fas fa-key" aria-hidden="true"></i></span>&nbsp;<span> @T["Change password"]</span></a></li>
            <li><button type="submit" class="dropdown-item"><span><i class="fa fa-sign-out-alt" aria-hidden="true"></i></span>&nbsp;<span> @T["Log off"]</span></button></li>
        </ul>
    </form>
</div>
